rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isServer() {
      // Trusted backend access is granted only by an Admin-SDK-issued custom claim.
      // Never trust an email address or a client-created password account.
      return isSignedIn() && request.auth.token.server == true;
    }

    // Keep tenant authorization deterministic and cheap. The previous
    // implementation performed many repeated get()/exists() calls while
    // evaluating a single request. That can hit Firestore Rules document-access
    // limits and surface as a generic "permission-denied" even for the owner.
    function isOwnerOfRestaurant(restaurantId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/restaurants/$(restaurantId))
        && (
          get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == request.auth.uid
          || (
            get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.provisioningType == 'initial_owner'
            && get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.createdBy == request.auth.uid
          )
          || (
            // Trusted owner pointer maintained in the authenticated user's profile.
            // The users/{uid} document may only point at a restaurant the same
            // user already owns or is actively a member of, so this cannot be
            // used to claim another tenant.
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.restaurantId == restaurantId
            && (
              get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == request.auth.uid
              || (
                get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.provisioningType == 'initial_owner'
                && get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.createdBy == request.auth.uid
              )
            )
          )
        );
    }

    function isMemberOfRestaurant(restaurantId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)/members/$(request.auth.uid)).data.isActive == true
        && (
          !('status' in get(/databases/$(database)/documents/restaurants/$(restaurantId)/members/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/restaurants/$(restaurantId)/members/$(request.auth.uid)).data.status != 'inactive'
        );
    }

    function canAccessRestaurant(restaurantId) {
      return isOwnerOfRestaurant(restaurantId) || isMemberOfRestaurant(restaurantId);
    }

    function getMemberData(restaurantId, userId) {
      return get(/databases/$(database)/documents/restaurants/$(restaurantId)/members/$(userId)).data;
    }

    function getMemberRole(restaurantId) {
      return getMemberData(restaurantId, request.auth.uid).role;
    }

    function isMemberWithRole(restaurantId, role) {
      return isMemberOfRestaurant(restaurantId) && getMemberRole(restaurantId) == role;
    }

    function isMemberWithRoles(restaurantId, roles) {
      return isMemberOfRestaurant(restaurantId) && getMemberRole(restaurantId) in roles;
    }

    function isAllowedOrderStatusTransition(fromStatus, toStatus) {
      return fromStatus == toStatus
        || (fromStatus == 'draft' && toStatus == 'confirmed')
        || (fromStatus == 'confirmed' && toStatus in ['sentToKitchen', 'cancelled'])
        || (fromStatus == 'sentToKitchen' && toStatus in ['preparing', 'cancelled'])
        || (fromStatus == 'preparing' && toStatus in ['ready', 'cancelled'])
        || (fromStatus == 'ready' && toStatus in ['served', 'cancelled'])
        || (fromStatus == 'served' && toStatus == 'completed')
        || (fromStatus == 'draft' && toStatus == 'cancelled');
    }

    /**
     * Server-authoritative subscription gate for NEW operational resources.
     *
     * The current subscription document is fixed at /subscription/current.
     * operationalAccessUntil MUST be a Firestore timestamp so Rules can compare
     * it with request.time. A missing/legacy field fails closed.
     *
     * Active states:
     *  - trial: active 7-day trial
     *  - active: paid subscription
     *  - grace_period: explicitly granted backend grace window
     *
     * Existing resources are intentionally NOT gated by this helper so staff can
     * close/settle work already in progress after an entitlement expires.
     */
    function isSubscriptionActive(restaurantId) {
      let subscription = get(
        /databases/$(database)/documents/restaurants/$(restaurantId)/subscription/current
      );
      return isSignedIn()
        && subscription.data.restaurantId == restaurantId
        && subscription.data.status in ['trial', 'active', 'grace_period']
        && subscription.data.operationalAccessUntil is timestamp
        && request.time < subscription.data.operationalAccessUntil;
    }

    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {
      // User profiles are self-readable, but security-sensitive role fields are never
      // client-writable. Restaurant membership remains the authoritative RBAC source.
      allow read: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.diff({}).affectedKeys().hasOnly([
          'userId', 'displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt',
          'restaurantId', 'initialRestaurantId'
        ])
        && (
          !('restaurantId' in request.resource.data)
          || !exists(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId))
          || get(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)).data.ownerId == request.auth.uid
          || (
            exists(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)/members/$(request.auth.uid))
            && get(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)/members/$(request.auth.uid)).data.isActive == true
          )
        );

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoUrl', 'updatedAt', 'restaurantId', 'initialRestaurantId'
        ])
        && (
          (
            request.resource.data.restaurantId == resource.data.restaurantId
            && request.resource.data.initialRestaurantId == resource.data.initialRestaurantId
          )
          || (
            ('restaurantId' in request.resource.data)
            && exists(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId))
            && (
              get(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)).data.ownerId == request.auth.uid
              || (
                exists(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)/members/$(request.auth.uid))
                && get(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)/members/$(request.auth.uid)).data.isActive == true
              )
            )
          )
        );
    }

    // ============================================================
    // CUSTOMERS (Milestone 9 - Phase 1)
    // Customer profile document at /customers/{customerId}.
    // Strictly owner-only access: only the authenticated customer can read/write their own profile.
    // ============================================================

    match /customers/{customerId} {
      allow read, write: if isSignedIn() && request.auth.uid == customerId;
    }

    // ============================================================
    // COLLECTION-GROUP MEMBERSHIP DISCOVERY
    // ============================================================
    // Allows a signed-in user to discover their own active or pending
    // membership/invitation records matching their UID or email.
    match /{path=**}/members/{memberId} {
      allow read: if isSignedIn()
        && (
          (resource.data.userId == request.auth.uid && resource.data.isActive == true)
          || (
            request.auth.token.email_verified == true
            && ('email' in resource.data)
            && resource.data.email == request.auth.token.email
          )
        );
    }

    // ============================================================
    // RESTAURANTS
    // ============================================================

    match /restaurants/{restaurantId} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.ownerId == request.auth.uid ||
        isMemberOfRestaurant(restaurantId) ||
        (resource.data.provisioningType == 'initial_owner' && resource.data.createdBy == request.auth.uid) ||
        isServer()
      );

      allow list: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        isServer()
      );

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if (
          isSignedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
        )
        || (
          isSignedIn()
          && resource.data.provisioningType == 'initial_owner'
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.provisioningType == resource.data.provisioningType
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'updatedAt'])
        );

      // Restaurant deletion is intentionally disabled at the document layer. A future
      // controlled backend purge can cascade subcollections and revoke access safely.
      allow delete: if false;

      // ==========================================================
      // MEMBERS
      // ==========================================================

      match /members/{memberId} {
        allow read: if isServer() || (isSignedIn() && (
          isOwnerOfRestaurant(restaurantId) ||
          isMemberWithRole(restaurantId, 'manager') ||
          request.auth.uid == memberId ||
          (
            request.auth.token.email_verified == true
            && ('email' in resource.data)
            && resource.data.email == request.auth.token.email
          )
        ));

        // Owners can create either a pending staff invitation or their own owner membership.
        allow create: if (
          isOwnerOfRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.memberId == memberId
          && (
            (
              request.resource.data.role in ['manager', 'cashier', 'kitchen', 'captain', 'accountant']
              && request.resource.data.userId == ''
              && request.resource.data.isActive == false
              && request.resource.data.status == 'pending_setup'
            )
            || (
              request.resource.data.role == 'owner'
              && memberId == request.auth.uid
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.isActive == true
              && request.resource.data.status == 'active'
            )
          )
        )
        // An authenticated invitee may create their linked membership only when the
        // authoritative pending invitation document is for the same email/role/restaurant.
        || (
          isSignedIn()
          && memberId == request.auth.uid
          && request.resource.data.memberId == memberId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.restaurantId == restaurantId
          && request.auth.token.email_verified == true
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.isActive == true
          && request.resource.data.status == 'active'
          && ('invitationId' in request.resource.data)
          && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/members/$(request.resource.data.invitationId))
          && get(/databases/$(database)/documents/restaurants/$(restaurantId)/members/$(request.resource.data.invitationId)).data.restaurantId == restaurantId
          && request.auth.token.email_verified == true
          && get(/databases/$(database)/documents/restaurants/$(restaurantId)/members/$(request.resource.data.invitationId)).data.email == request.auth.token.email
          && get(/databases/$(database)/documents/restaurants/$(restaurantId)/members/$(request.resource.data.invitationId)).data.role == request.resource.data.role
          && get(/databases/$(database)/documents/restaurants/$(restaurantId)/members/$(request.resource.data.invitationId)).data.isActive == false
          && get(/databases/$(database)/documents/restaurants/$(restaurantId)/members/$(request.resource.data.invitationId)).data.invitationStatus in ['pending_setup', 'invitation_sent', 'invitation_failed']
        );

        allow update: if (
          isOwnerOfRestaurant(restaurantId)
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.memberId == resource.data.memberId
        )
        || (
          isSignedIn()
          && request.auth.uid == memberId
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.memberId == resource.data.memberId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoUrl', 'phone', 'updatedAt'])
        )
        || (
          isSignedIn()
          && ('email' in resource.data)
          && request.auth.token.email_verified == true
          && resource.data.email == request.auth.token.email
          && resource.data.isActive == false
          && resource.data.invitationStatus in ['pending_setup', 'invitation_sent', 'invitation_failed']
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'authLinked', 'invitationStatus', 'updatedAt'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.authLinked == true
          && request.resource.data.invitationStatus == 'active'
        );

        allow delete: if isOwnerOfRestaurant(restaurantId);
      }

      // ==========================================================
      // CATEGORIES
      // ==========================================================

      match /categories/{categoryId} {
        allow read: if isServer()
          || canAccessRestaurant(restaurantId)
          || exists(/databases/$(database)/documents/publicRestaurants/$(restaurantId));
        allow create: if (isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager'))
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.categoryId == categoryId;

        allow update: if (isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager'))
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.categoryId == resource.data.categoryId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'description', 'imageUrl', 'sortOrder', 'isActive', 'updatedAt'
          ]);

        allow delete: if isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager');
      }

      // ==========================================================
      // MENU ITEMS
      // ==========================================================

      match /items/{itemId} {
        allow read: if isServer()
          || canAccessRestaurant(restaurantId)
          || exists(/databases/$(database)/documents/publicRestaurants/$(restaurantId));
        allow create: if (isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager'))
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.itemId == itemId;

        allow update: if (isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager'))
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.itemId == resource.data.itemId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'categoryId', 'name', 'shortName', 'description', 'imageUrl', 'price', 'taxRate',
            'taxInclusive', 'foodType', 'isAvailable', 'sku', 'sortOrder', 'updatedAt'
          ]);

        allow delete: if isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager');
      }

      // ==========================================================
      // TABLES
      // ==========================================================

      match /tables/{tableId} {
        allow read: if isServer() || canAccessRestaurant(restaurantId);

        allow create: if isSubscriptionActive(restaurantId)
          && (isOwnerOfRestaurant(restaurantId)
            || isMemberWithRole(restaurantId, 'manager'))
          && request.resource.data.restaurantId == restaurantId;

        allow delete: if (isOwnerOfRestaurant(restaurantId)
          || isMemberWithRole(restaurantId, 'manager'))
          && resource.data.restaurantId == restaurantId;

        allow update: if (isOwnerOfRestaurant(restaurantId)
          || isMemberWithRole(restaurantId, 'manager'))
          && request.resource.data.restaurantId == resource.data.restaurantId
          || (
            isServer()
            && request.resource.data.restaurantId == resource.data.restaurantId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeSessionId', 'status', 'updatedAt'])
            && ((request.resource.data.status == 'available' && request.resource.data.activeSessionId == null)
              || (request.resource.data.status == 'occupied' && request.resource.data.activeSessionId is string))
          )
          || (
            isMemberWithRoles(restaurantId, ['cashier', 'captain'])
            && request.resource.data.restaurantId == resource.data.restaurantId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['activeSessionId', 'status', 'updatedAt'])
            && (
              (request.resource.data.status == 'occupied'
                && request.resource.data.activeSessionId is string)
              || (request.resource.data.status == 'available'
                && request.resource.data.activeSessionId == null)
            )
          );
      }

      // ==========================================================
      // TABLE SESSIONS
      // ==========================================================

      match /tableSessions/{sessionId} {
        allow read: if isServer() || canAccessRestaurant(restaurantId);

        allow create: if (
          isSubscriptionActive(restaurantId)
          && (
            isServer()
            || isOwnerOfRestaurant(restaurantId)
            || isMemberWithRoles(restaurantId, ['manager', 'cashier', 'captain'])
          )
        )
          && request.resource.data.id == sessionId
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.tableId is string
          && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/tables/$(request.resource.data.tableId))
          && request.resource.data.status == 'open'
          && (isServer() || isOwnerOfRestaurant(restaurantId) || request.resource.data.openedBy == request.auth.uid);

        allow update: if (
          isServer()
          || isOwnerOfRestaurant(restaurantId)
          || isMemberWithRoles(restaurantId, ['manager', 'cashier', 'captain'])
        )
          && request.resource.data.id == sessionId
          && (!('id' in resource.data) || resource.data.id == sessionId)
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.tableId == resource.data.tableId
          && (
            (
              resource.data.status == 'open'
              && request.resource.data.status == 'open'
              && request.resource.data.guestCount is int
              && request.resource.data.guestCount > 0
              && (isServer() || isOwnerOfRestaurant(restaurantId) || request.resource.data.updatedBy == request.auth.uid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['id', 'guestCount', 'updatedBy', 'updatedAt'])
            )
            ||
            (
              resource.data.status == 'open'
              && request.resource.data.status == 'closed'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['id', 'status', 'closedAt', 'closedBy', 'updatedAt'])
              && (isServer() || isOwnerOfRestaurant(restaurantId) || request.resource.data.closedBy == request.auth.uid)
            )
          );

        allow delete: if isServer() || isOwnerOfRestaurant(restaurantId)
          || isMemberWithRole(restaurantId, 'manager');
      }

      // ==========================================================
      // ORDERS
      // ==========================================================

      match /orders/{orderId} {
        allow read: if isServer() || (
          // Only staff with order visibility may access order documents.
          isOwnerOfRestaurant(restaurantId)
          || isMemberWithRoles(restaurantId, ['manager', 'cashier', 'captain', 'accountant'])
          || (
            isMemberWithRole(restaurantId, 'kitchen')
            && resource.data.source == 'online'
            && resource.data.orderType in ['takeaway', 'delivery']
          )
        )
        || (
          isSignedIn()
          && resource != null
          && ('customerId' in resource.data)
          && resource.data.customerId != null
          && resource.data.customerId == request.auth.uid
        );

        // Orders creation is permitted for trusted server authority or verified restaurant staff/owner.
        allow create: if isSubscriptionActive(restaurantId)
          && (
            (
              isServer()
              && request.resource.data.restaurantId == restaurantId
              && request.resource.data.id == orderId
              && request.resource.data.createdBy is string
            ) || (
              isSignedIn()
              && (isOwnerOfRestaurant(restaurantId) || isMemberWithRoles(restaurantId, ['manager', 'cashier', 'captain']))
              && request.resource.data.restaurantId == restaurantId
              && request.resource.data.id == orderId
              && request.resource.data.createdBy == request.auth.uid
            )
          );

        // Financial/order-total fields are protected. Cashiers may only settle an order when
        // the same atomic transaction creates the linked Payment record; managers/owners retain
        // full correction/refund authority. Operational roles are limited to non-financial fields.

        // Partial item-cancellation is executed through the trusted backend. The backend
        // verifies the caller role and validates item-by-item reductions; the server claim
        // then performs the Firestore write under the existing trusted server authority.
        // The trusted server uses this exact shape for partial item cancellation;
        // client users never receive the server claim and therefore cannot use this branch.
        allow update: if (
          (isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager') || isServer())
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
        )
        || (
          isMemberWithRole(restaurantId, 'cashier')
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.id == resource.data.id
          && (isServer() || request.resource.data.updatedBy == request.auth.uid)
          && request.resource.data.status != 'cancelled'
          && request.resource.data.status != 'completed'
          && isAllowedOrderStatusTransition(resource.data.status, request.resource.data.status)
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'acceptedAt', 'acceptedBy', 'estimatedPrepMinutes', 'sentToKitchenAt',
              'readyAt', 'readyBy', 'servedAt', 'servedBy',
              'updatedAt', 'updatedBy', 'stockConsumptionStatus', 'stockConsumptionError',
              'notes', 'customerSnapshot'
            ])
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['stockConsumptionStatus'])
              || (
                request.resource.data.stockConsumptionStatus in ['consumed', 'not_applicable']
                && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/order_stock_locks/$(orderId))
                && get(/databases/$(database)/documents/restaurants/$(restaurantId)/order_stock_locks/$(orderId)).data.orderId == orderId
                && get(/databases/$(database)/documents/restaurants/$(restaurantId)/order_stock_locks/$(orderId)).data.actorType == 'server'
                && get(/databases/$(database)/documents/restaurants/$(restaurantId)/order_stock_locks/$(orderId)).data.status == request.resource.data.stockConsumptionStatus
              )
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'paidAmountMinor', 'dueAmountMinor', 'paymentStatus', 'lastPaymentId', 'updatedAt', 'updatedBy'
              ])
              && ('lastPaymentId' in request.resource.data)
              && request.resource.data.lastPaymentId is string
              && request.resource.data.lastPaymentId != ''
              && !exists(/databases/$(database)/documents/restaurants/$(restaurantId)/payments/$(request.resource.data.lastPaymentId))
              && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/payments/$(request.resource.data.lastPaymentId)).data.restaurantId == restaurantId
              && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/payments/$(request.resource.data.lastPaymentId)).data.orderId == orderId
              && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/payments/$(request.resource.data.lastPaymentId)).data.createdBy == request.auth.uid
              && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/payments/$(request.resource.data.lastPaymentId)).data.status in ['pending', 'completed', 'failed']
              && (
                getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/payments/$(request.resource.data.lastPaymentId)).data.status != 'completed'
                || (
                  request.resource.data.paidAmountMinor == resource.data.paidAmountMinor + getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/payments/$(request.resource.data.lastPaymentId)).data.amountMinor
                  && request.resource.data.dueAmountMinor == (resource.data.grandTotalMinor > request.resource.data.paidAmountMinor ? resource.data.grandTotalMinor - request.resource.data.paidAmountMinor : 0)
                  && request.resource.data.paymentStatus == (request.resource.data.dueAmountMinor == 0 ? 'paid' : 'partially_paid')
                )
                || (
                  getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/payments/$(request.resource.data.lastPaymentId)).data.status in ['pending', 'failed']
                  && request.resource.data.paidAmountMinor == resource.data.paidAmountMinor
                  && request.resource.data.dueAmountMinor == resource.data.dueAmountMinor
                  && request.resource.data.paymentStatus == resource.data.paymentStatus
                )
              )
            )
          )
        )
        || (
          isMemberWithRole(restaurantId, 'captain')
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.id == resource.data.id
          && (isServer() || request.resource.data.updatedBy == request.auth.uid)
          && request.resource.data.status != 'cancelled'
          && request.resource.data.status != 'completed'
          && isAllowedOrderStatusTransition(resource.data.status, request.resource.data.status)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'acceptedAt', 'acceptedBy', 'estimatedPrepMinutes', 'sentToKitchenAt',
            'readyAt', 'readyBy', 'servedAt', 'servedBy', 'updatedAt', 'updatedBy',
            'stockConsumptionStatus', 'stockConsumptionError', 'notes', 'customerSnapshot'
          ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['stockConsumptionStatus'])
            || (
              request.resource.data.stockConsumptionStatus in ['consumed', 'not_applicable']
              && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/order_stock_locks/$(orderId))
              && get(/databases/$(database)/documents/restaurants/$(restaurantId)/order_stock_locks/$(orderId)).data.actorType == 'server'
              && get(/databases/$(database)/documents/restaurants/$(restaurantId)/order_stock_locks/$(orderId)).data.status == request.resource.data.stockConsumptionStatus
            )
          )
        )
        || (
          isMemberWithRole(restaurantId, 'kitchen')
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.id == resource.data.id
          && request.resource.data.status != 'cancelled'
          && isAllowedOrderStatusTransition(resource.data.status, request.resource.data.status)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'sentToKitchenAt', 'readyAt', 'readyBy', 'servedAt', 'servedBy',
            'updatedAt', 'updatedBy'
          ])
        );

        allow delete: if (isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager'))
          && resource.data.restaurantId == restaurantId
          && resource.data.status == 'draft'
          && (!('paymentStatus' in resource.data) || resource.data.paymentStatus == 'unpaid')
          && (!('paidAmountMinor' in resource.data) || resource.data.paidAmountMinor == 0)
          && (!('stockConsumptionStatus' in resource.data) || resource.data.stockConsumptionStatus in ['not_applicable', 'failed']);
      }

      // ==========================================================
      // KOTS
      // ==========================================================

      match /kots/{kotId} {
        allow read: if isServer() || canAccessRestaurant(restaurantId);

        // KOT creation is permitted for trusted server authority or verified staff/kitchen/owner.
        allow create: if isSubscriptionActive(restaurantId)
          && (
            (
              isServer()
              && request.resource.data.restaurantId == restaurantId
              && request.resource.data.id == kotId
              && request.resource.data.orderId is string
              && request.resource.data.createdBy is string
              && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId))
              && get(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.restaurantId == restaurantId
            ) || (
              isSignedIn()
              && (isOwnerOfRestaurant(restaurantId) || isMemberWithRoles(restaurantId, ['manager', 'cashier', 'captain', 'kitchen']))
              && request.resource.data.restaurantId == restaurantId
              && request.resource.data.id == kotId
              && request.resource.data.orderId is string
              && request.resource.data.createdBy == request.auth.uid
            )
          );

        // Partial item-cancellation writes are server-authoritative. The API authenticates
        // the caller's owner/manager/captain/kitchen role, then the trusted server
        // validates item-by-item quantity reductions before this rules-level write.
        allow update: if (
          isServer()
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.id == resource.data.id
          && request.resource.data.orderId == resource.data.orderId
          && request.resource.data.orderId is string
          && request.resource.data.updatedBy is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'items', 'status', 'updatedBy', 'updatedAt',
            'cancellationReason', 'cancelledAt', 'cancelledBy'
          ])
          && resource.data.status != 'served'
          && resource.data.status != 'cancelled'
          && (
            request.resource.data.status == resource.data.status
            || (
              request.resource.data.status == 'cancelled'
              && isAllowedOrderStatusTransition(resource.data.status, 'cancelled')
              && request.resource.data.cancelledBy == request.resource.data.updatedBy
            )
          )
        )
        || (
          (isOwnerOfRestaurant(restaurantId)
          || isMemberWithRoles(restaurantId, ['manager', 'kitchen', 'captain']))
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.id == resource.data.id
          && request.resource.data.orderId == resource.data.orderId
          && request.resource.data.orderId is string
          && (isServer() || request.resource.data.updatedBy == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'sentToKitchenAt', 'preparingAt', 'readyAt', 'servedAt',
            'updatedBy', 'updatedAt'
          ])
          && isAllowedOrderStatusTransition(resource.data.status, request.resource.data.status)
        )
        || (
          (isOwnerOfRestaurant(restaurantId)
          || isMemberWithRoles(restaurantId, ['manager', 'kitchen', 'captain']))
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.id == resource.data.id
          && request.resource.data.orderId == resource.data.orderId
          && (isServer() || (request.resource.data.updatedBy == request.auth.uid && request.resource.data.cancelledBy == request.auth.uid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'items', 'status', 'cancellationReason', 'cancelledAt', 'cancelledBy', 'updatedBy', 'updatedAt'
          ])
          && request.resource.data.status == 'cancelled'
          && resource.data.status != 'served'
          && isAllowedOrderStatusTransition(resource.data.status, 'cancelled')
        );

        allow delete: if isOwnerOfRestaurant(restaurantId)
          || isMemberWithRole(restaurantId, 'manager');
      }

      // ==========================================================
      // PAYMENTS
      // ==========================================================

      match /payments/{paymentId} {
        allow read: if isServer() || isOwnerOfRestaurant(restaurantId)
          || isMemberWithRoles(restaurantId, ['manager', 'cashier', 'accountant']);

        allow create: if (
          (isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager'))
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.id == paymentId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.orderId is string
          && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId))
          && get(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.restaurantId == restaurantId
          && request.resource.data.amountMinor is number
          && request.resource.data.amountMinor > 0
          && request.resource.data.amountMinor % 1 == 0
          && request.resource.data.status in ['pending', 'completed', 'failed']
          && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.lastPaymentId == paymentId
          && (
            request.resource.data.status != 'completed'
            || (
              getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.paidAmountMinor
                == get(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.paidAmountMinor + request.resource.data.amountMinor
              && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.dueAmountMinor
                == (getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.grandTotalMinor > getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.paidAmountMinor
                  ? getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.grandTotalMinor - getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.paidAmountMinor
                  : 0)
              && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.paymentStatus
                == (getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.dueAmountMinor == 0 ? 'paid' : 'partially_paid')
            )
            || (
              request.resource.data.status in ['pending', 'failed']
              && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.paidAmountMinor == get(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.paidAmountMinor
              && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.dueAmountMinor == get(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.dueAmountMinor
              && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.paymentStatus == get(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.paymentStatus
            )
          )
        )
        || (
          isMemberWithRole(restaurantId, 'cashier')
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.id == paymentId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.orderId is string
          && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId))
          && get(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.restaurantId == restaurantId
          && request.resource.data.amountMinor is number
          && request.resource.data.amountMinor > 0
          && request.resource.data.amountMinor % 1 == 0
          && request.resource.data.status in ['pending', 'completed', 'failed']
          && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.lastPaymentId == paymentId
          && (
            request.resource.data.status != 'completed'
            || (
              getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.paidAmountMinor
                == get(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.paidAmountMinor + request.resource.data.amountMinor
              && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.dueAmountMinor
                == (getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.grandTotalMinor > getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.paidAmountMinor
                  ? getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.grandTotalMinor - getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.paidAmountMinor
                  : 0)
              && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.paymentStatus
                == (getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)).data.dueAmountMinor == 0 ? 'paid' : 'partially_paid')
            )
          )
        );

        allow update: if (
          (isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager'))
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.id == resource.data.id
          && request.resource.data.orderId == resource.data.orderId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'refundReason', 'refundedAt', 'refundedBy', 'updatedBy', 'updatedAt'
          ])
        );

        allow delete: if false; // Payment records are append-only; use refund status updates.
      }

      // ==========================================================
      // AUDIT LOGS — APPEND ONLY
      // ==========================================================

      match /auditLogs/{auditId} {
        allow create: if (canAccessRestaurant(restaurantId)
            && request.resource.data.restaurantId == restaurantId
            && request.auth != null
            && request.resource.data.actorUid == request.auth.uid)
          || isServer();

        allow read: if isServer() || isOwnerOfRestaurant(restaurantId)
          || isMemberWithRoles(restaurantId, ['manager', 'accountant']);

        allow update, delete: if false;
      }

      // ==========================================================
      // DEVICES & OPERATIONAL REGISTRY
      // ==========================================================

      match /devices/{deviceId} {
        allow read: if isServer() || canAccessRestaurant(restaurantId);
        allow create: if (isOwnerOfRestaurant(restaurantId)
          || isMemberWithRole(restaurantId, 'manager')
          || isMemberWithRoles(restaurantId, ['cashier', 'captain']))
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.deviceId == deviceId;

        allow update: if (isOwnerOfRestaurant(restaurantId)
          || isMemberWithRole(restaurantId, 'manager')
          || isMemberWithRoles(restaurantId, ['cashier', 'captain']))
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.deviceId == resource.data.deviceId;
        allow delete: if isOwnerOfRestaurant(restaurantId)
          || isMemberWithRole(restaurantId, 'manager');
      }

       // ==========================================================
      // IDEMPOTENCY
      // ==========================================================
 
       match /idempotency/{key} {
         allow read: if isServer() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
         allow create: if (
             isServer()
             && request.resource.data.restaurantId == restaurantId
             && request.resource.data.id == key
             && request.resource.data.createdBy == request.auth.uid
             && request.resource.data.operation is string
             && request.resource.data.requestSignature is string
           ) || (
             canAccessRestaurant(restaurantId)
             && request.resource.data.restaurantId == restaurantId
             && request.resource.data.id == key
             && request.resource.data.createdBy == request.auth.uid
             && request.resource.data.operation is string
             && request.resource.data.requestSignature is string
           );
         allow update: if (
             isServer()
             && request.resource.data.restaurantId == resource.data.restaurantId
             && request.resource.data.id == resource.data.id
             && request.resource.data.createdBy == resource.data.createdBy
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'targetEntityId', 'responseSnapshot', 'errorMessage', 'updatedAt', 'lockedAt'])
           ) || (
             canAccessRestaurant(restaurantId)
             && request.resource.data.restaurantId == resource.data.restaurantId
             && request.resource.data.id == resource.data.id
             && request.resource.data.createdBy == resource.data.createdBy
             && resource.data.createdBy == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'targetEntityId', 'responseSnapshot', 'errorMessage', 'updatedAt', 'lockedAt'])
           );
       }
 
       match /idempotencyKeys/{key} {
         allow read: if isServer() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
         allow create: if (
             isServer()
             && request.resource.data.restaurantId == restaurantId
             && request.resource.data.id == key
             && request.resource.data.createdBy == request.auth.uid
             && request.resource.data.operation is string
             && request.resource.data.requestSignature is string
           ) || (
             canAccessRestaurant(restaurantId)
             && request.resource.data.restaurantId == restaurantId
             && request.resource.data.id == key
             && request.resource.data.createdBy == request.auth.uid
             && request.resource.data.operation is string
             && request.resource.data.requestSignature is string
           );
         allow update: if (
             isServer()
             && request.resource.data.restaurantId == resource.data.restaurantId
             && request.resource.data.id == resource.data.id
             && request.resource.data.createdBy == resource.data.createdBy
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'targetEntityId', 'responseSnapshot', 'errorMessage', 'updatedAt', 'lockedAt'])
           ) || (
             canAccessRestaurant(restaurantId)
             && request.resource.data.restaurantId == resource.data.restaurantId
             && request.resource.data.id == resource.data.id
             && request.resource.data.createdBy == resource.data.createdBy
             && resource.data.createdBy == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'targetEntityId', 'responseSnapshot', 'errorMessage', 'updatedAt', 'lockedAt'])
           );
       }

       // ==========================================================
       // ORDER STOCK LOCKS (Idempotent stock consumption lock)
       // ==========================================================

       match /order_stock_locks/{lockId} {
 allow read: if isServer() || canAccessRestaurant(restaurantId);
         allow create: if isServer()
           && request.resource.data.restaurantId == restaurantId
           && request.resource.data.orderId == lockId
           && request.resource.data.actorUid == request.auth.uid
           && request.resource.data.actorType == 'server'
           && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(lockId))
           && request.resource.data.status in ['consumed', 'not_applicable'];
         allow update: if isServer()
           && request.resource.data.restaurantId == resource.data.restaurantId
           && request.resource.data.orderId == resource.data.orderId
           && request.resource.data.actorUid == resource.data.actorUid
           && request.resource.data.actorType == resource.data.actorType
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reversedAt', 'reversedBy', 'reversalReason', 'updatedAt']);
         allow delete: if false;
       }

      // ==========================================================
      // INVENTORY ITEMS
      // ==========================================================

      match /inventoryItems/{itemId} {
        allow read: if isServer() || canAccessRestaurant(restaurantId);

        allow create: if (isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager'))
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.id == itemId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.currentQuantity is number
          && request.resource.data.currentQuantity >= 0;

        // Inventory master-data updates never mutate currentQuantity. Stock balance changes
        // only through the stock movement / trusted server workflows.
        allow update: if (isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager'))
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'normalizedName', 'sku', 'unit', 'minimumQuantity', 'reorderQuantity',
            'costPerUnitPaise', 'active', 'status', 'updatedBy', 'updatedAt'
          ])
          && request.resource.data.updatedBy == request.auth.uid;

        allow update: if isServer()
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentQuantity', 'updatedAt', 'updatedBy']);

        allow delete: if isOwnerOfRestaurant(restaurantId);
      }

      // ==========================================================
      // STOCK MOVEMENTS — IMMUTABLE APPEND ONLY
      // ==========================================================

      match /stockMovements/{movementId} {
        allow read: if isServer() || canAccessRestaurant(restaurantId);

        allow create: if (
          isServer()
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.id == movementId
          && request.resource.data.actorUid is string
        ) || (
          (isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager'))
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.id == movementId
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.type == 'opening'
          && request.resource.data.inventoryItemId is string
          && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/inventoryItems/$(request.resource.data.inventoryItemId))
          && get(/databases/$(database)/documents/restaurants/$(restaurantId)/inventoryItems/$(request.resource.data.inventoryItemId)).data.restaurantId == restaurantId
        );

        // Historical movements are immutable except for the single server-owned reversal link.
        allow update: if isServer()
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.id == resource.data.id
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reversedByMovementId'])
          && request.resource.data.reversedByMovementId is string;
        allow delete: if false;
      }

      // ==========================================================
      // SUPPLIERS
      // ==========================================================

      match /suppliers/{supplierId} {
        allow read: if isServer() || isOwnerOfRestaurant(restaurantId)
          || isMemberWithRoles(restaurantId, ['manager', 'accountant']);

        allow create: if (isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager'))
          && request.resource.data.restaurantId == restaurantId;

        allow update: if (isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager'))
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.supplierId == resource.data.supplierId;

        allow delete: if isOwnerOfRestaurant(restaurantId);
      }

      // ==========================================================
      // PURCHASE ORDERS
      // ==========================================================

      match /purchaseOrders/{purchaseOrderId} {
        allow read: if isServer() || isOwnerOfRestaurant(restaurantId)
          || isMemberWithRoles(restaurantId, ['manager', 'accountant']);

        allow create: if (isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager'))
          && request.resource.data.restaurantId == restaurantId;

        allow update: if (
          (isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager'))
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.purchaseOrderId == resource.data.purchaseOrderId
        ) || (
            isServer()
            && request.resource.data.restaurantId == resource.data.restaurantId
            && request.resource.data.purchaseOrderId == resource.data.purchaseOrderId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'items', 'updatedAt', 'updatedBy'])
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.status in ['submitted', 'partiallyReceived', 'received']
          );

        allow delete: if isOwnerOfRestaurant(restaurantId);
      }

      // ==========================================================
      // PURCHASE RECEIVINGS — IMMUTABLE APPEND ONLY
      // ==========================================================

      match /purchaseReceivings/{receivingId} {
        allow read: if isServer() || isOwnerOfRestaurant(restaurantId)
          || isMemberWithRoles(restaurantId, ['manager', 'accountant']);

        allow create: if (
          (isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager'))
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.id == receivingId
          && request.resource.data.actorUid == request.auth.uid
        ) || (
            isServer()
            && request.resource.data.restaurantId == restaurantId
            && request.resource.data.id == receivingId
            && request.resource.data.actorUid == request.auth.uid
            && request.resource.data.purchaseOrderId is string
          );

        allow update, delete: if false; // Historical receiving records are strictly immutable
      }

      // ==========================================================
      // RECIPES (BOM)
      // ==========================================================

      match /recipes/{recipeId} {
        allow read: if isServer() || canAccessRestaurant(restaurantId);

        allow create: if (isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager'))
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.id == recipeId
          && request.resource.data.recipeId == recipeId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;

        allow update: if (isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager'))
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.id == resource.data.id
          && request.resource.data.recipeId == resource.data.recipeId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ingredients', 'estimatedCostPaise', 'status', 'notes', 'updatedAt', 'updatedBy'
          ])
          && request.resource.data.updatedBy == request.auth.uid;

        allow delete: if isOwnerOfRestaurant(restaurantId);
      }

      // ==========================================================
      // STOCK CONSUMPTIONS — IMMUTABLE AUDIT LOG
      // ==========================================================

      match /stockConsumptions/{consumptionId} {
        allow read: if isServer() || canAccessRestaurant(restaurantId);

        allow create: if isServer()
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.id == consumptionId
          && request.resource.data.consumptionId == consumptionId
          && request.resource.data.orderId is string
          && request.resource.data.inventoryItemId is string
          && request.resource.data.status == 'consumed';

        // Only the trusted stock-processing backend can reverse/adjust consumption records.
        allow update: if isServer()
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.id == resource.data.id
          && request.resource.data.consumptionId == resource.data.consumptionId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'reversedAt', 'reversedBy', 'reversalMovementId', 'reversalReason', 'reversedQuantity', 'updatedAt'
          ]);

        allow delete: if false;
      }

      // ==========================================================
      // PRINTERS & HARDWARE
      // ==========================================================

      match /printers/{printerId} {
        allow read: if isServer() || canAccessRestaurant(restaurantId);

        allow create: if (isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager'))
          && request.resource.data.restaurantId == restaurantId;

        allow update: if (isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager'))
          && request.resource.data.restaurantId == resource.data.restaurantId;

        allow delete: if isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager');
      }

      match /printJobs/{jobId} {
        allow read: if isServer() || canAccessRestaurant(restaurantId);

        allow create: if canAccessRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId;

        allow update: if canAccessRestaurant(restaurantId)
          && request.resource.data.restaurantId == resource.data.restaurantId;

        allow delete: if isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager');
      }


      // ==========================================================
      // SUBSCRIPTION & TRIAL
      // Rules are deployed from the repository's firebase.json Firestore target.
      // Owner/Server controlled, immutable history, strict tenant scoping
      // ==========================================================

      match /subscription/{subDocId} {
        allow read: if canAccessRestaurant(restaurantId) || isServer();

        // Subscription entitlements are server-authoritative. Browser clients may
        // read the current subscription, but must never create or mutate it directly.
        allow create, update: if isServer()
          && request.resource.data.restaurantId == restaurantId;

        allow delete: if false;
      }

      match /subscriptionHistory/{historyId} {
        allow read: if canAccessRestaurant(restaurantId) || isServer();

        // Payment history is an immutable server-owned audit trail.
        allow create: if isServer()
          && request.resource.data.restaurantId == restaurantId;

        allow update, delete: if false;
      }

    }

    // ============================================================
    // PUBLIC RESTAURANTS DISCOVERY
    // Sanitized, non-sensitive public discovery collection.
    // Read-only to public customers; writable only by restaurant owners/managers.
    // ============================================================
    match /publicRestaurants/{restaurantId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager')
      ) && request.resource.data.restaurantId == restaurantId;
      allow update: if isSignedIn() && (
        isOwnerOfRestaurant(restaurantId) || isMemberWithRole(restaurantId, 'manager')
      ) && request.resource.data.restaurantId == resource.data.restaurantId;
    }

    // ============================================================
    // SUBSCRIPTION WEBHOOK IDEMPOTENCY RECORDS
    // Global root collection: /subscriptionWebhookEvents/{eventId}
    // Server-only access. Strictly protected against client/browser tampering.
    // ============================================================
    match /subscriptionWebhookEvents/{eventId} {
      allow read, write: if isServer();
    }

    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

