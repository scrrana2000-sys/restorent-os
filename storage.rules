rules_version = '2';
// Public customer image rules are deployed by deploy-firebase-rules.yml.

service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================
    // HELPERS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isRestaurantOwner(restaurantId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/restaurants/$(restaurantId))
        && firestore.get(/databases/(default)/documents/restaurants/$(restaurantId)).data.ownerId == request.auth.uid;
    }

    function isRestaurantMember(restaurantId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/restaurants/$(restaurantId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/restaurants/$(restaurantId)/members/$(request.auth.uid)).data.isActive == true
        && firestore.get(/databases/(default)/documents/restaurants/$(restaurantId)/members/$(request.auth.uid)).data.get('status', 'active') != 'inactive';
    }

    function canAccessRestaurant(restaurantId) {
      return isRestaurantOwner(restaurantId)
        || isRestaurantMember(restaurantId);
    }

    function isValidImageUpload() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isStoredPublicImage() {
      return resource != null
        && resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{allPaths=**} {
      allow read, write: if false;
    }

    // ============================================================
    // PUBLIC CUSTOMER IMAGES
    // Anonymous customers may read only these exact folders.
    // Writes/deletes remain restricted to authenticated staff/owners.
    // ============================================================

    match /restaurants/{restaurantId}/public/logo/{fileName} {
      allow read: if isStoredPublicImage();
      allow create: if canAccessRestaurant(restaurantId) && isValidImageUpload();
      allow update: if canAccessRestaurant(restaurantId) && isValidImageUpload();
      allow delete: if canAccessRestaurant(restaurantId);
    }

    match /restaurants/{restaurantId}/public/banner/{fileName} {
      allow read: if isStoredPublicImage();
      allow create: if canAccessRestaurant(restaurantId) && isValidImageUpload();
      allow update: if canAccessRestaurant(restaurantId) && isValidImageUpload();
      allow delete: if canAccessRestaurant(restaurantId);
    }

    match /restaurants/{restaurantId}/public/items/{fileName} {
      allow read: if isStoredPublicImage();
      allow create: if canAccessRestaurant(restaurantId) && isValidImageUpload();
      allow update: if canAccessRestaurant(restaurantId) && isValidImageUpload();
      allow delete: if canAccessRestaurant(restaurantId);
    }

    // ============================================================
    // LEGACY CUSTOMER IMAGE PATHS
    // Existing image URLs may still point to the old folders.
    // Keep only these three known image locations publicly readable.
    // New uploads use /public/... paths above.
    // ============================================================

    match /restaurants/{restaurantId}/logo/{fileName} {
      allow read: if isStoredPublicImage();
      allow create: if canAccessRestaurant(restaurantId) && isValidImageUpload();
      allow update: if canAccessRestaurant(restaurantId) && isValidImageUpload();
      allow delete: if canAccessRestaurant(restaurantId);
    }

    match /restaurants/{restaurantId}/branding/banner/{fileName} {
      allow read: if isStoredPublicImage();
      allow create: if canAccessRestaurant(restaurantId) && isValidImageUpload();
      allow update: if canAccessRestaurant(restaurantId) && isValidImageUpload();
      allow delete: if canAccessRestaurant(restaurantId);
    }

    match /restaurants/{restaurantId}/items/{fileName} {
      allow read: if isStoredPublicImage();
      allow create: if canAccessRestaurant(restaurantId) && isValidImageUpload();
      allow update: if canAccessRestaurant(restaurantId) && isValidImageUpload();
      allow delete: if canAccessRestaurant(restaurantId);
    }

    // ============================================================
    // ALL OTHER RESTAURANT-SCOPED STORAGE
    // Remains restricted to authenticated owner/staff.
    // ============================================================

    match /restaurants/{restaurantId}/{allPaths=**} {
      allow read: if canAccessRestaurant(restaurantId);

      allow create: if canAccessRestaurant(restaurantId)
        && isValidImageUpload();

      allow update: if canAccessRestaurant(restaurantId)
        && isValidImageUpload();

      allow delete: if canAccessRestaurant(restaurantId);
    }
  }
}
