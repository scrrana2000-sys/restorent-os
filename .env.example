# RestaurantOS Environment Configuration
# Optional: External third-party integrations can be defined here if enabled.

# Optional password for the authenticated system-server account
SYSTEM_SERVER_PASSWORD=

# Razorpay Payment Gateway Credentials (Server-Side Only)
# Never expose RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET to frontend code or Vite env
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
